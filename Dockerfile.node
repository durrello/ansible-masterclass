# Dockerfile.node
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and Python (Ansible needs Python)
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server python3 python3-apt sudo ca-certificates curl \
    && mkdir /var/run/sshd \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create a user "devuser"
RUN useradd -m -s /bin/bash devuser && echo "devuser:devpass" | chpasswd && adduser devuser sudo \
    && echo "devuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Allow SSH login for root and devuser
RUN echo 'PermitRootLogin yes' >> /etc/ssh/sshd_config

# Prepare SSH directories
RUN mkdir -p /root/.ssh /home/devuser/.ssh && chmod 700 /root/.ssh /home/devuser/.ssh && chown devuser:devuser /home/devuser/.ssh

EXPOSE 22
CMD ["/usr/sbin/sshd","-D"]

